# docker-compose.yaml이 참조하는 환경변수 — 이 파일을 .env로 복사해서 오버라이드하면
# 된다. .env가 없어도 docker-compose.yaml에 박힌 기본값(${VAR:-기본값})만으로 로컬
# 실행은 그대로 된다 — 아래 기본값은 전부 로컬 개발 전용이며, 프로덕션 배포 시에는
# 반드시 실제 시크릿으로 교체할 것.

# --- postgres (N-01 감사증적 + F-04 pgvector) ---
POSTGRES_USER=vps_app
POSTGRES_PASSWORD=vps_dev_password
POSTGRES_DB=vps_detector
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vps_app:vps_dev_password@postgres:5432/vps_detector

# --- N-02 RBAC: 조회/처리/관리자 API 키 ---
API_KEYS=dev-viewer-key:viewer,dev-handler-key:handler,dev-admin-key:admin
# api -> mcp-server 서비스 대 서비스 자격증명. 위 API_KEYS의 handler 키와 동일해야 한다.
MCP_SERVICE_API_KEY=dev-handler-key
# frontend가 브라우저에서 api를 호출할 때 쓰는 키(NEXT_PUBLIC_*로 노출되므로 진짜
# 비밀키는 아님 — apps/frontend/src/lib/api.ts 상단 주석 참고).
API_HANDLER_KEY=dev-handler-key

# --- mcp-server가 호출하는 Ollama (컨테이너 밖, 호스트에서 별도로 떠 있어야 함) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- grafana ---
GRAFANA_ADMIN_PASSWORD=vps_dev_admin

# --- 호스트에 노출할 포트 (다른 프로젝트와 충돌하면 여기서만 바꾸면 됨) ---
API_PORT=8000
MCP_SERVER_PORT=8100
RAG_WORKER_PORT=8200
STT_WORKER_PORT=8300
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
